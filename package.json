{
  "name": "lvsyn-hybrid-trip-companion",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Offline-capable on-device + cloud hybrid AI trip editing companion powered by Firebase AI Logic, Chrome Gemini Nano, and deterministic schedule verification.",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "node scripts/local-cloud-emulator.mjs",
