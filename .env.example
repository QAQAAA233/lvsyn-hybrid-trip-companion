# Copy to .env.local and fill with your own free Spark-plan Firebase Web config.
# Do NOT commit .env.local or any real credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: provide EITHER a reCAPTCHA v3 site key (production) OR debug token ("true" for localhost auto-generation)
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=

# Optional cloud fallback model (free-tier default in @firebase/ai@3.1.0 is gemini-3.5-flash-lite)
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# Local dev emulator URL (only set during local offline/fallback development, e.g. http://127.0.0.1:8788)
VITE_AI_EMULATOR_URL=
